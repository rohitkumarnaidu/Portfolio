# ══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — Portfolio Platform
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# 
# For NestJS API backend env vars, see config/.env.example.
#
# Reference: docs/SystemArchitecture.md §10 (Environment Configuration)
# ══════════════════════════════════════════════════════════════

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Authentication (JWT + admin cookies) ─────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_APP_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# OAuth (optional). Only pre-provisioned admin accounts can sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/admin/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/admin/auth/github/callback

# ── Site Configuration ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# Server-side API origin. Browser requests always use same-origin /api/*.
API_PROXY_TARGET=http://localhost:3001

# ── PostHog (Analytics) ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry (Error Tracking) ──────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=sntrys_your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=portfolio-web

# ── Resend (Email) ───────────────────────────────────────────
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_REPLY_TO=reply@yourdomain.com

# ── Telegram (Alerts) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# ── Better Uptime (Monitoring) ───────────────────────────────
BETTER_UPTIME_API_KEY=your-better-uptime-key

# ── API Service (NestJS) ─────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# ── ISR Revalidation ────────────────────────────────────────
# Secret shared between NestJS API and Next.js to trigger on-demand ISR revalidation
REVALIDATION_SECRET=your-revalidation-secret-here

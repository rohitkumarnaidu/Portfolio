# ══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — NestJS API
# ══════════════════════════════════════════════════════════════
# Copy this file to config/.env and fill in your values.
# The API and prisma seed load it automatically; real process env wins.
# For Next.js frontend env vars, see ../.env.example.
# For AI service (FastAPI) env vars, see ../apps/ai/.env.example.
# ══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Web origin used for OAuth redirects and the admin dashboard.
ADMIN_APP_URL=http://localhost:3000

# Where Next.js (server-side) and the API proxy send API requests.
# The browser always uses same-origin /api/*; this is server-to-server only.
API_PROXY_TARGET=http://localhost:3001

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars
# Bootstrap administrator created by `npm run prisma:seed`.
# ADMIN_PASSWORD is required by the seed and must be at least 8 characters.
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=change-me-before-seeding

# Admin session cookies. Set COOKIE_SECURE=true behind HTTPS and
# COOKIE_DOMAIN only when the API and web app share a parent domain.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# OAuth (optional). Admins must already exist; OAuth never creates accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/admin/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/admin/auth/github/callback

# Account lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MS=900000

# ── Redis (optional caching / queues) ────────────────────────
# Leave empty to run without Redis. Sessions are stored in Postgres.
REDIS_URL=redis://localhost:6379

# ── AI Service ───────────────────────────────────────────────
AI_API_URL=http://localhost:8000
OPENAI_API_KEY=your-openai-api-key

# ── Sentry (error tracking) ──────────────────────────────────
SENTRY_DSN=your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-sentry-public-dsn

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@portfolio.com
ADMIN_NOTIFICATION_EMAIL=admin@portfolio.com

# ── ISR Revalidation ─────────────────────────────────────────
REVALIDATION_SECRET=your-revalidation-secret-here

# ── Frontend: reCAPTCHA v3 (public site key only — no secret here) ──
# If unset, the contact form skips reCAPTCHA gracefully.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

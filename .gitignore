# Git ignore patterns for node, build outputs
# Dependencies
node_modules/
.pnp/
.pnp.js

# Build
.next/
out/
build/
dist/

# Testing
coverage/

# Misc
.DS_Store
*.pem
*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — keep the examples tracked
.env
.env.*
!.env.example
!**/.env.example

# Secrets and credentials
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
credentials*.json
service-account*.json
.netrc
_netrc
.sentryclirc

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.opencode/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/
.pytest_cache/

# Build outputs per workspace
apps/web/.next/
apps/web/out/
apps/api/dist/
apps/api/generated/

# Python
apps/ai/__pycache__/

# Supabase
supabase/.branches/
# Turborepo
.turbo/

# OS / Temporary files
Thumbs.db
.DS_Store

# Additional local files and data
.npmrc
*.db
*.db-journal
*.sqlite
*.sqlite3
apps/web/test.js
test.js

# Tool caches and test artifacts
.eslintcache
.stylelintcache
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Windows
Thumbs.db
Desktop.ini

# Specific path ignoring for cases where standard patterns didn't match
apps/ai/venv/
apps/web/.vscode/
**/.venv/
**/venv/

# Playwright MCP local artifacts
.playwright-mcp/

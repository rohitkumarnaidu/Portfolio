# ══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — Portfolio site
# ══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# The portfolio is a static Next.js site. Its content lives in
# apps/web/src/lib/public-content.ts, so nothing here is required to
# build or run it — these are only for the optional integrations.
# ══════════════════════════════════════════════════════════════

# ── Site Configuration ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── PostHog (Analytics) ──────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Sentry (Error Tracking) ──────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=sntrys_your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=portfolio-web

# ── Contact form ─────────────────────────────────────────────
# The contact form composes a mailto: link, so it needs no server.
CONTACT_EMAIL=you@yourdomain.com

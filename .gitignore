# Git ignore patterns for node, build outputs

# Dependencies
node_modules/
.pnp/
.pnp.js

# Build
.next/
out/
build/
dist/

# Testing
coverage/

# Misc
.DS_Store
*.pem
*.log

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — keep the examples tracked
.env
.env.*
!.env.example
!**/.env.example

# Secrets and credentials
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
credentials*.json
service-account*.json
.netrc
_netrc
.sentryclirc

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# OpenCode session state is ignored; project skills are tracked
.opencode/*
!.opencode/skills/
!.opencode/skills/**

# Build outputs per workspace
apps/web/.next/
apps/web/out/
apps/api/dist/
apps/api/generated/

# Turborepo
.turbo/

# Local files
.npmrc
*.db
*.db-journal
*.sqlite
*.sqlite3
apps/api/data/

# Tool caches and test artifacts
.eslintcache
.stylelintcache
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Windows
Thumbs.db
Desktop.ini

# Playwright MCP local artifacts
.playwright-mcp/
